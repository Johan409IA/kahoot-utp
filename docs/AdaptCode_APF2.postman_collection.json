                "value": "Bearer {{tokenEstudiante}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"participacionId\": {{participacionId}},\n  \"preguntaId\": {{preguntaId2}},\n  \"acierto\": true,\n  \"omitida\": false,\n  \"tiempoMs\": 7000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/salas/{{salaId}}/respuestas"
          }
        },
        {
          "name": "Responder P3 (estudiante)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEstudiante}}"
