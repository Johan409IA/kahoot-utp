                  "pm.collectionVariables.set('salaId', j.id);",
                  "pm.collectionVariables.set('pin', j.pin);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Sala en vivo",
      "item": [
        {
          "name": "Abrir espera (docente)",
          "request": {
            "method": "POST",
            "header": [
