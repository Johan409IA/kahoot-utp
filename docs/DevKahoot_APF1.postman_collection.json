								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"estudianteId\": 1,\n  \"preguntaId\": 1,\n  \"opcionSeleccionada\": \"SELECT\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/partidas/{{codigoPartida}}/respuestas",
