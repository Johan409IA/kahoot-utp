					"name": "1.3 Obtener todas las preguntas",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/preguntas",
							"host": ["{{baseUrl}}"],
							"path": ["api", "preguntas"]
						}
					},
					"response": []
				}
			]
		},
