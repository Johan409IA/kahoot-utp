						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"estudianteId\": 1,\n  \"preguntaId\": 1,\n  \"opcionSeleccionada\": \"INSERT\"\n}"
						},
						"description": "Mismo estudiante y misma pregunta que 3.1. Respuesta esperada: 409 Conflict. La respuesta no se registra y el puntaje del estudiante permanece igual (verificar con 4.3 Obtener estudiante por id).",
						"url": {
							"raw": "{{baseUrl}}/api/partidas/{{codigoPartida}}/respuestas",
							"host": ["{{baseUrl}}"],
							"path": ["api", "partidas", "{{codigoPartida}}", "respuestas"]
						}
					},
					"response": []
