			"name": "1. Preguntas",
			"item": [
				{
					"name": "1.1 Crear primera pregunta de SQL",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"enunciado\": \"¿Qué instrucción se usa para consultar datos en SQL?\",\n  \"opciones\": [\"SELECT\", \"INSERT\", \"UPDATE\", \"DELETE\"],\n  \"respuestaCorrecta\": \"SELECT\",\n  \"explicacion\": \"SELECT permite consultar datos de una tabla.\",\n  \"categoria\": \"SQL\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/preguntas",
							"host": ["{{baseUrl}}"],
							"path": ["api", "preguntas"]
						}
					},
					"response": []
				},
				{
					"name": "1.2 Crear segunda pregunta de SQL",
