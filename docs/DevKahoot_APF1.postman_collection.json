						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"enunciado\": \"¿Qué cláusula se usa para filtrar registros en SQL?\",\n  \"opciones\": [\"WHERE\", \"ORDER BY\", \"GROUP BY\", \"VALUES\"],\n  \"respuestaCorrecta\": \"WHERE\",\n  \"explicacion\": \"WHERE permite filtrar los registros que cumplen una condición.\",\n  \"categoria\": \"SQL\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/preguntas",
							"host": ["{{baseUrl}}"],
							"path": ["api", "preguntas"]
						}
					},
					"response": []
